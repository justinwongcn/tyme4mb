///|
// LunarYear 农历年
pub struct LunarYear {
  year_unit : YearUnit
}

///|
extend LunarYear with Culture::{get_name}

///|
extend LunarYear with Show::{to_string}

///|
extend LunarYear with Tyme::{next}

///|
// validate 校验
pub fn LunarYear::validate(year : Int) -> Result[Unit, String] {
  if year < -1 || year > 9999 {
    return Err("illegal lunar year: " + year.to_string())
  }
  Ok(())
}

///|
// lunar_year_leap_chars 编码字符表
let lunar_year_leap_chars : String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_@"
///|
// lunar_year_leap_data 闰月年编码数据（每行一段，2 字符 64 进制编码，累加得该闰月对应年份）
let lunar_year_leap_data : Array[String] = [
			"080b0r0j0j0j0C0j0j0C0j0j0j0C0j0C0j0C0F0j0V0V0V0u0j0j0C0j0j0j0j0V0C0j1v0u0C0V1v0C0b080u110u0C0j0C1v9K1v2z0j1vmZbl1veN3s1v0V0C2S1v0V0C2S2o0C0j1Z1c2S1v0j1c0j2z1v0j1c0j392H0b2_2S0C0V0j1c0j2z0C0C0j0j1c0j0N250j0C0j0b081n080b0C0C0C1c0j0N",
			"0r1v1c1v0V0V0F0V0j0C0j0C0j0V0j0u1O0j0C0V0j0j0j0V0b080u0r0u080b0j0j0C0V0C0V0j0b080V0u080b0j0j0u0j1v0u080b1c0j080b0j0V0j0j0V0C0N1v0j1c0j0j1v2g1v420j1c0j2z1v0j1v5Q9z1v4l0j1vfn1v420j9z4l1v1v2S1c0j1v2S3s1v0V0C2S1v1v2S1c0j1v2S2_0b0j2_2z0j1c0j",
			"",
			"_",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"0B0j0V0j0j0C0j0j0j0C0j0C0j0j0C0j0m0j0j0j0j0C0j0C0j0j0u0j1c0j0j0C0C0j0j0j0j0j0j0j0j0u110N0j0j0V0C0V0j0b081n080b0CrU1O5e2SbX2_1Z0V2o141v0j0C0C0j2z1v0j1c0j7N1O420j1c0j1v2S1c0j1v2S2_0b0j0V0j0j1v0N1v0j0j1c0j1v140j0V0j0j0C0C0b080u1v0C0V0u110u0j0j0j0C0j0j0j0C0C0N0C0V0j0j0C0j0j0b080u110u0C0j0C0u0r0C0u080b0j0j0C0j0j0j",
]

///|
// build_lunar_year_leap 构建闰月年表
fn build_lunar_year_leap() -> Array[Array[Int]] {
  let res : Array[Array[Int]] = []
  for i = 0; i < lunar_year_leap_data.length(); i = i + 1 {
    let m = lunar_year_leap_data[i]
    let size = m.length() / 2
    let mut n = 0
    let l : Array[Int] = []
    for y = 0; y < size; y = y + 1 {
      let z = y * 2
      let mut t = 0
      let mut c = 1
      for x = 1; x > -1; x = x - 1 {
        let idx = z + x
        t = t + c * chars_index(lunar_year_leap_chars, m.unsafe_charcode_at(idx))
        c = c * 64
      }
      n = n + t
      l.push(n)
    }
    res.push(l)
  }
  res
}

///|
// chars_index 字符在表中的索引
fn chars_index(chars : String, c : Int) -> Int {
  for i = 0; i < chars.length(); i = i + 1 {
    if chars.unsafe_charcode_at(i) == c {
      return i
    }
  }
  0
}

///|
let lunar_year_leap : Array[Array[Int]] = build_lunar_year_leap()

///|
// from_year 从年构造
pub fn LunarYear::from_year(year : Int) -> Result[LunarYear, String] {
  match LunarYear::validate(year) {
    Ok(_) => Ok(LunarYear::{ year_unit: YearUnit::new(year) })
    Err(e) => Err(e)
  }
}

///|
// get_year 年
pub fn LunarYear::get_year(self : LunarYear) -> Int {
  self.year_unit.get_year()
}

///|
// get_day_count 天数
pub fn LunarYear::get_day_count(self : LunarYear) -> Int {
  let mut n = 0
  let months = self.get_months()
  for i = 0; i < months.length(); i = i + 1 {
    n = n + months[i].get_day_count()
  }
  n
}

///|
// get_month_count 月数
pub fn LunarYear::get_month_count(self : LunarYear) -> Int {
  if self.get_leap_month() < 1 {
    return 12
  }
  13
}

///|
// get_leap_month 闰月数字，1代表闰1月，0代表无闰月
pub fn LunarYear::get_leap_month(self : LunarYear) -> Int {
  if self.get_year() == -1 {
    return 11
  }
  for i = 0; i < lunar_year_leap.length(); i = i + 1 {
    let value = lunar_year_leap[i]
    for j = 0; j < value.length(); j = j + 1 {
      if value[j] == self.get_year() {
        return i + 1
      }
    }
  }
  0
}

///|
// get_sixty_cycle 干支
pub fn LunarYear::get_sixty_cycle(self : LunarYear) -> SixtyCycle {
  SixtyCycle::from_index(self.get_year() - 4)
}

///|
// get_twenty 运
pub fn LunarYear::get_twenty(self : LunarYear) -> Twenty {
  Twenty::from_index(
    @math.floor((self.get_year() - 1864).to_double() / 20.0).to_int(),
  )
}

///|
// get_nine_star 九星
pub fn LunarYear::get_nine_star(self : LunarYear) -> NineStar {
  NineStar::from_index(
    63 + self.get_twenty().get_sixty().get_index() * 3 -
    self.get_sixty_cycle().get_index(),
  )
}

///|
// get_jupiter_direction 太岁方位
pub fn LunarYear::get_jupiter_direction(self : LunarYear) -> Direction {
  let arr = [0, 7, 7, 2, 3, 3, 8, 1, 1, 6, 0, 0]
  Direction::from_index(
    arr[self.get_sixty_cycle().get_earth_branch().get_index()],
  )
}

///|
// get_first_month 首月（农历月，即一月，俗称正月）
pub fn LunarYear::get_first_month(self : LunarYear) -> LunarMonth {
  match LunarMonth::from_ym(self.get_year(), 1) {
    Ok(m) => m
    Err(_) =>
      LunarMonth::{
        month_unit: MonthUnit::new(YearUnit::new(self.get_year()), 1),
        leap: false,
      }
  }
}

///|
// get_months 月份列表，一般有12个月，当年有闰月时，有13个月。
pub fn LunarYear::get_months(self : LunarYear) -> Array[LunarMonth] {
  let l : Array[LunarMonth] = []
  let y = self.get_year()
  let leap_month = self.get_leap_month()
  for i = 1; i < 13; i = i + 1 {
    match LunarMonth::from_ym(y, i) {
      Ok(m) => l.push(m)
      Err(_) => ()
    }
    if i == leap_month {
      match LunarMonth::from_ym(y, -i) {
        Ok(m) => l.push(m)
        Err(_) => ()
      }
    }
  }
  l
}

///|
// get_kitchen_god_steed 灶马头
pub fn LunarYear::get_kitchen_god_steed(self : LunarYear) -> KitchenGodSteed {
  KitchenGodSteed::from_lunar_year(self.get_year())
}

///|
impl Culture for LunarYear with get_name(self : LunarYear) -> String {
  // 依据国家标准《农历的编算和颁行》GB/T 33661-2017，默认采用干支纪年法
  "农历\{self.get_sixty_cycle().to_string()}年"
}

///|
impl Show for LunarYear with to_string(self : LunarYear) -> String {
  self.get_name()
}

///|
impl Tyme for LunarYear with next(self : LunarYear, n : Int) -> LunarYear {
  match LunarYear::from_year(self.get_year() + n) {
    Ok(y) => y
    Err(_) => self
  }
}
